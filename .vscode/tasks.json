{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Agda to PDF",
      "type": "shell",
      "command": "cd ${fileDirname}; agda --latex --latex-dir=. ${fileBasename}; if ($LASTEXITCODE -eq 0) { latexmk -pdf ${fileBasenameNoExtension}.tex }",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
