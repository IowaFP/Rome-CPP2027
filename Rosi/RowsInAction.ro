-- ============================================================================
-- Imports
-- 
-- Ro.Base defines:
-- - Bool, True, False, ite, or
-- - Unit, tt 
-- - Const, const
-- - Id, id 
-- - Nat, zero, succ
-- - Pairs, Triples, pair, triple
-- ============================================================================

import Ro.Base 

-- ============================================================================
-- Points
-- ============================================================================

type Point : R[⋆]
type Point = {'x ▹ Nat , 'y ▹ Nat}

-- constructor
point x y = ('x ▹ x, 'y ▹ y)

-- ============================================================================
-- Trees
-- ============================================================================

type TreeF : R[⋆ → ⋆]
type TreeF = {'Leaf ▹ Const Nat, 'Branch ▹ λ tree. Pair tree tree}

type Tree : ⋆
type Tree = μ (Σ TreeF)

-- Constructors
leaf : Nat → Tree
leaf n = inj ('Leaf ▹ n)

branch : Tree → Tree → Tree
branch l r = inj ('Branch ▹ pair l r)

-- ============================================================================
-- Reducting Rows --- the Functor type and fmapΣ
-- ============================================================================

type Functor : (⋆ → ⋆) → ⋆
type Functor f = forall a b. (a → b) → f a → f b

fmapΣ : forall z : R[⋆ → ⋆]. Π (Functor z) → Functor (Σ z)
fmapΣ d @a @b f = ana #(λ X. X a) (λ l v. inj (l := d.l f v))

-- ============================================================================
-- Desugaring Booleans --- BoolF, eval, and desugarOr
-- ============================================================================
-------------------------------------------------------------------------------
-- Defining Boolean formulae and Booleans

type BoolF : R[⋆ → ⋆]
type BoolF = {'True ▹ Const Unit , 'False ▹ Const Unit , 
              'If ▹ λ b. Triple b b b , 'Or ▹ λ b. Pair b b}  

-------------------------------------------------------------------------------
-- Boolean formulae evaluation

eval : μ (Σ BoolF) → Bool
eval = fix (λ eval. 
      (case 'True (const true)) 
    | (case 'False (const false))
    | (case 'If (λ p. if 
                  (eval p.'1) 
                  (eval p.'3) 
                  (eval p.'3)))
    | (case 'Or (λ p. or
                  (eval p.'1) 
                  (eval p.'2))))

-------------------------------------------------------------------------------
-- We can verify that 
--   Σ BoolF ≡ λ b. Σ {'True ▹ ⊤ , 'False ▹ ⊤ , 'If ▹ b × b × b , 'Or ▹ b × b}  
-- by checking if the following term type-checks

checkΣBoolF : μ (Σ BoolF) → 
              μ (Σ {'True ▹ Const Unit , 
                    'False ▹ Const Unit , 
                    'If ▹ λ b. Triple b b b , 
                    'Or ▹ λ b. Pair b b})
checkΣBoolF = id

-------------------------------------------------------------------------------
-- Desugaring "Or" statements

type Or : R[⋆ → ⋆]
type Or = {'Or ▹ λ b. Pair b b}

-- desugarOr : μ (Σ BoolF) → μ (Σ (BoolF ∖ Or))
-- desugarOr = ? 
--  fix (λ desugar. 
  --   (case 'True (inj true)) 
  -- | (case 'False (inj false))
  -- | (case 'If ?) -- (λ p. inj ('If ▹ p))
  -- | (case 'Or ?))

-------------------------------------------------------------------------------
-- We can verify that 
--     BoolF ∖ Or
--   = {'True  ▹ const Unit, 
--      'False  ▹ const Unit, 
--      'If ▹ λ b. b × b × b}
-- by checking if the following term type-checks

checkBoolFOr : μ (Π (BoolF ∖ Or)) → μ (Π {'True ▹ Const Unit, 'False ▹ Const Unit, 'If ▹ λ b. Triple b b b})
checkBoolFOr = id

-- ============================================================================
-- Predicates and Containment --- LamF and desugar
-- ============================================================================
-------------------------------------------------------------------------------
-- The AST for lambda expressions

type LamF : R[⋆ → ⋆]
type LamF = {'Lam ▹ λ x. x , 
             'App ▹ λ x. Pair x x , 
             'Var ▹ Const Nat}

