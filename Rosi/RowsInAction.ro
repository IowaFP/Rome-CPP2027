-- ============================================================================
-- Section 2: Rows in Action
-- ----------------------------------------------------------------------------
-- 
-- Section 2 only describes Rosi types, but this document gives terms to 
-- each type using Rosi's highly expressive forms of label-generic programming.
-- Some syntax in the paper differs from Rosi syntax here, as:
-- 1. I use some pseudo-syntax for clarity in the text, such as:
--   - I write "row Point = ..." rather than "type Point = ...", 
--     just to emphasize that what's being introduced is a row.
--   - I write a × b instead of Pair a b, and a × b × c instead of Triple a b c
--   - I write ⊤ instead of Unit
-- 3. I leave maps implicit here, e.g., Π (Functor z) instead of 
--    Π (Functor $ z), as in the text.
-- 2. Rosi has a *lot* of syntactic sugar for more ergonomic programming, 
--    such as:
--    - left-hand arguments; 
--    - equi-recursive type construction; 
--    - inferred types; and
--    - implicit type quantification. 
--    There is also a lot of sugar I am not using, such as ('Foo: bar)
--    for variant construction, and ('Foo: a → M) for variant elimination.
--    
-- ----------------------------------------------------------------------------
-- To run:
-- 
-- 1. make sure you have downloaded Rosi (github.com/IowaFP/Rosi).
-- 2. cabal install Rosi to somewhere in your $PATH
-- 2. Run 
--    rosi RowsInAction.ro
-- 
-- Note that: Definitions in Base are the target of elaboration of syntactic
-- sugar so it is crucial that it be included.
-- 
-- ============================================================================
-- Imports
-- ============================================================================

import Ro.Base 

-- ============================================================================
-- Some basic types and type constructors
-- ============================================================================
-------------------------------------------------------------------------------
-- Identity type and function

type Id : * → *
type Id x = x

id : t → t
id x = x

-------------------------------------------------------------------------------
-- Constant type and function

-- Const type operator
type Const : ⋆ → ⋆ → ⋆
type Const = λ a x. a

-- const function
const : t → u → t
const x y = x

-------------------------------------------------------------------------------
-- The Unit Type

-- The unit type as empty record
type Unit : ⋆
type Unit = Π {} 

tt : Unit
tt = prj ('l := λ x. x)

-------------------------------------------------------------------------------
-- The Nat Type

type NatF : ⋆ → ⋆
type NatF n = Σ {'Zero ▹ Unit , 'Succ ▹ n }

type Nat : ⋆
type Nat = μ NatF

-- N.b. Rosi has implicit In/Out coercions, making it behave, effectively,
-- as an equi-recursive type system.
zero : Nat 
zero = (inj ('Zero ▹ tt))

suc : Nat → Nat
suc n = inj ('Succ ▹ n)

-------------------------------------------------------------------------------
-- Pairs and triples

type Pair : ⋆ → ⋆ → ⋆
type Pair x y =  Π {'1 ▹ x, '2 ▹ y}

type Triple  : ⋆ → ⋆ → ⋆ → ⋆
type Triple x y z = Π {'1 ▹ x, '2 ▹ y , '3 ▹ z}

-- Constructors
pair : x → y → Pair x y
pair x y = ('1 ▹ x, '2 ▹ y)

triple : x → y → z → Triple x y z
triple x y z = ('1 ▹ x, '2 ▹ y, '3 ▹ z)

-- ============================================================================
-- Points
-- ============================================================================

type Point : R[⋆]
type Point = {'x ▹ Nat , 'y ▹ Nat}

-- constructor
point x y = ('x ▹ x, 'y ▹ y)

-- ============================================================================
-- Trees
-- ============================================================================

type TreeF : R[⋆ → ⋆]
type TreeF = {'Leaf ▹ Const Nat, 'Branch ▹ λ tree. Pair tree tree}

type Tree : ⋆
type Tree = μ (Σ TreeF)

-- Constructors
leaf : Nat → Tree
leaf n = inj ('Leaf ▹ n)

branch : Tree → Tree → Tree
branch l r = inj ('Branch ▹ pair l r)

-- ============================================================================
-- Reducting Rows --- the Functor type and fmapΣ
-- ============================================================================

type Functor : (⋆ → ⋆) → ⋆
type Functor f = forall a b. (a → b) → f a → f b

fmapΣ : forall z : R[⋆ → ⋆]. Π (Functor z) → Functor (Σ z)
fmapΣ d @a @b f = ana #(λ X. X a) (λ l v. inj (l := d.l f v))

-- ============================================================================
-- Desugaring Booleans --- BoolF, eval, and desugarOr
-- ============================================================================

-------------------------------------------------------------------------------
-- Defining Boolean formulae and Booleans

type BoolF : R[⋆ → ⋆]
type BoolF = {'T ▹ Const Unit , 'F ▹ Const Unit , 
              'If ▹ λ b. Triple b b b , 'Or ▹ λ b. Pair b b}  

type Bool : ⋆
type Bool =  Σ {'T ▹ Unit , 'F ▹ Unit}

-- constructors
true : {'T ▹ Unit} < z ⇒ Σ z 
true = inj ('T := tt)

false : {'F ▹ Unit} < z ⇒ Σ z 
false = inj ('F := tt)

-------------------------------------------------------------------------------
-- Boolean formulae evaluation

-- eliminators, for use in defining eval
ite : Bool → a → a → a 
ite b x y = match b
  (case 'T (λ t. x) | case 'F (λ t. y))

or : Bool → Bool → Bool
or a b = ite a true b

-- evaluating bools
eval : μ (Σ BoolF) → Bool
eval = fix (λ eval. 
      (case 'T (const true)) 
    | (case 'F (const false))
    | (case 'If (λ p. ite 
                  (eval p.'1) 
                  (eval p.'3) 
                  (eval p.'3)))
    | (case 'Or (λ p. or
                  (eval p.'1) 
                  (eval p.'2))))

-------------------------------------------------------------------------------
-- Desugaring "Or" statements

-- We can verify that 
--   Σ BoolF ≡ λ b. Σ {'T ▹ ⊤ , 'F ▹ ⊤ , 'If ▹ b × b × b , 'Or ▹ b × b}  
-- bye checking if:
--   _ : (Σ BoolF) b → Σ {'T ▹ ⊤ , 'F ▹ ⊤ , 'If ▹ b × b × b , 'Or ▹ b × b} 
-- type checks under the identity.
checkΣBoolF : (Σ BoolF) b → 
              Σ {'T ▹ Unit , 
                 'F ▹ Unit , 
                 'If ▹ Triple b b b , 
                 'Or ▹ Pair b b}
checkΣBoolF = id

type Or : R[⋆ → ⋆]
type Or = {'Or ▹ λ b. Pair b b}

-- desugarOr : μ (Σ BoolF) → μ (Σ (BoolF ∖ Or))
-- desugarOr = ? 
--  fix (λ desugar. 
  --   (case 'T (inj true)) 
  -- | (case 'F (inj false))
  -- | (case 'If ?) -- (λ p. inj ('If ▹ p))
  -- | (case 'Or ?))

-- We can verify that 
--     BoolF ∖ Or
--   = {'T  ▹ const Unit, 
--      'F  ▹ const Unit, 
--      'If ▹ λ b. b × b × b}
checkBoolFOr : Π ((BoolF ∖ Or) a) → Π {'T ▹ Unit, 'F ▹ Unit, 'If ▹ Triple a a a}
checkBoolFOr = id

-- ============================================================================
-- Predicates and Containment --- LamF and desugar
-- ============================================================================
-------------------------------------------------------------------------------
-- The AST for lambda expressions

type LamF : R[⋆ → ⋆]
type LamF = {'Lam ▹ λ x. x , 
             'App ▹ λ x. Pair x x , 
             'Var ▹ Const Nat}

-------------------------------------------------------------------------------
-- Desugaring boolean formulae to Lambda expressions

desugar : forall z : R[⋆ → ⋆]. BoolF < z, LamF < (z ∖ BoolF) ⇒
          μ (Σ z) → μ (Σ (z ∖ BoolF))
desugar = ?          