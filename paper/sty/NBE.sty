% -----------------------------------------------------------------------------
% IIRC this adds a conditional that is true when a command is used in text
% and false when a command is used in math-mode. For example, the command
% \ExC{Ty} renders "Ty" inline and "\mathrm{Ty}" in math environments.

\newif\ifinline\inlinetrue
\makeatletter
\everymath{%
  \ifingather@%
    \inlinefalse%
  \else \ifinalign@%
      \inlinefalse%
    \else%
      \inlinetrue%
    \fi \fi}
\makeatother
\everydisplay{\inlinefalse}  
