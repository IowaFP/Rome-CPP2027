% -----------------------------------------------------------------------------
%  Dynamically change the placement of equation numbers (tags) between 
%  the left and right sides within the same document

\makeatletter
\newcommand{\leqnomode}{\tagsleft@true\let\veqno\@@leqno}
\newcommand{\reqnomode}{\tagsleft@false\let\veqno\@@eqno}
\makeatother

